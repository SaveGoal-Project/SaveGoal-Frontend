# ========================
# SaveGoal Frontend - Environment Variables
# ========================
# Copy this file to .env.local and fill in the values
# cp .env.example .env.local

# ========================
# API Configuration
# ========================
# Backend API base URL for local development
NEXT_PUBLIC_API_URL=http://localhost:4308/api

# ========================
# Authentication
# ========================
# Set to "true" to use mock auth (disable in production!)
NEXT_PUBLIC_USE_MOCK_AUTH=false

# ========================
# App Metadata
# ========================
NEXT_PUBLIC_APP_NAME=SaveGoal
NEXT_PUBLIC_APP_URL=http://localhost:4310

# ========================
# External Services (uncomment and add keys as needed)
# ========================
# NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=
# NEXT_PUBLIC_SENTRY_DSN=
